<html>

<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<meta http-equiv="Content-Language" content="en-us">
<title>Fill in the form below to order</title>
<!--mstheme--><link rel="stylesheet" type="text/css" href="_themes/eclipse/ecli1011.css"><meta name="Microsoft Theme" content="eclipse 1011, default">
</head>

<body>

<p>
<!--webbot bot="PurpleText" preview="Feedback Form - Customize the form below to collect the information you need. By default, the form data is saved to a text file on the web server using the FrontPage Save Results component. Edit the Form Properties to change this behavior." -->
</p>
<hr>
<p>Fill in the form below to order your hosting service.</p>
<form method="POST" action="_vti_bin/shtml.exe/order%20form.htm" onsubmit="return FrontPage_Form1_Validator(this)" language="JavaScript" name="FrontPage_Form1" webbot-action="--WEBBOT-SELF--">
  <!--webbot bot="SaveResults" U-File="_private/feedback.csv" S-Format="TEXT/CSV" S-Label-Fields="TRUE" B-Reverse-Chronology="FALSE" S-Email-Format="TEXT/PRE" S-Email-Address="paul@pacific-host.com" B-Email-Label-Fields="TRUE" S-Date-Format="%d %b %Y" S-Time-Format="%H:%M:%S" S-Builtin-Fields="REMOTE_NAME REMOTE_USER HTTP_USER_AGENT Date Time" startspan --><input TYPE="hidden" NAME="VTI-GROUP" VALUE="0"><!--webbot bot="SaveResults" i-checksum="43374" endspan -->
  <p><strong>What plan are you ordering?</strong></p>
  <dl>
    <dd><input type="radio" name="MessageType" value="Platinum" checked>Platinum&nbsp;
    <input type="radio" name="MessageType" value="Gold">Gold
    <input type="radio" name="MessageType" value="Silver">Silver
    <input type="radio" name="MessageType" value="Mail 5 pack">Mail 5 pack
    <input type="radio" name="MessageType" value="Mail 10 pack">Mail 10 pack
    <input type="radio" name="MessageType" value="Forwarding">Forwarding</dd>
  </dl>
  <p><strong>Tell us your domain name.</strong></p>
  <dl>
    <dd><select name="Service" size="1">
    <option selected>Hosting</option>
    <option>Mail</option>
    <option>Forwarding</option>
    </select> Domain:&nbsp;
    <input type="text" size="26" maxlength="256" name="Domain"><select size="1" name="extension">
    <option selected>.com</option>
    <option>.org</option>
    <option>.net</option>
    <option>.us</option>
    <option>.biz</option>
    </select><br>
&nbsp;</dd>
    <dt>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Preferred User Name:
    <input type="text" name="username" size="8"><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Preferred Password:&nbsp;&nbsp;
    <input type="password" name="password" size="20">&nbsp; </dt>
  </dl>
  <p><strong>Enter any special instructions in the space provided below:</strong></p>
  <dl>
    <dd><textarea name="Requests" rows="5" cols="42"></textarea></dd>
  </dl>
  <p><strong>Tell us how to get in touch with you:</strong></p>
  <dl>
    <dd>
    <table>
      <tr>
        <td>Name</td>
        <td><input type="text" size="35" maxlength="256" name="Name"></td>
      </tr>
      <tr>
        <td>E-mail</td>
        <td><input type="text" size="35" maxlength="256" name="email"></td>
      </tr>
      <tr>
        <td>Tel</td>
        <td><input type="text" size="35" maxlength="256" name="UserTel"></td>
      </tr>
      <tr>
        <td>CC#</td>
        <td><input type="text" size="16" maxlength="256" name="CC"></td>
      </tr>
      <tr>
        <td>Exp.</td>
        <td><input type="text" size="7" name="Exp" maxlength="7"></td>
      </tr>
    </table>
    <table id="table1">
      <tr>
        <td>Amount to be Charged</td>
        <td width="120">
        &nbsp;<!--webbot bot="Validation" s-data-type="Number" s-number-separators=",." i-maximum-length="7" --><input type="text" size="16" name="amount" maxlength="7"></td>
      </tr>
    </table>
    <p>
<form action="https://www.paypal.com/cgi-bin/webscr" method="post">
<input type="hidden" name="encrypted" value="-----BEGIN PKCS7----------END PKCS7-----
">
<input type="hidden" name="cmd" value="_s-xclick">
</form>
  <dl>
    <dd><input type="checkbox" name="ContactRequested" value="ContactRequested"> 
    Please contact me as soon as possible regarding this matter.</dd>
  </dl>
  <p><input type="submit" value="Submit Comments">
  <input type="reset" value="Clear Form"></p>
</form>
<hr>
